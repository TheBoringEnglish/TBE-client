# TheBoringEnglish 桌面算力与发音客户端配置范例
# 本地用户配置默认自动持久化在用户目录: ~/.tbe_client_config.json
# 如果需要在启动时通过环境变量覆盖，可在此配置：

# TBE 服务端地址（默认连接官方服务或本地服务）
TBE_SERVER_URL=https://theboringenglish.com
# 算力服务 WebSocket 地址（默认从 TBE_SERVER_URL 派生，例如 wss://theboringenglish.com/ws/compute）
# TBE_SERVER_WS_URL=wss://theboringenglish.com/ws/compute

# 本地 Remotion 服务地址（默认监听 6402）
REMOTION_SERVICE_URL=http://localhost:6402

# 用户认证 Token（建议在客户端界面直接点击登录获取，无需在此手动填入）
# TBE_TOKEN=

# 本地离线模型存放目录（默认自动存放在用户目录 ~/.tbe_client/models）
# CLIENT_MODELS_DIR=
